# Zoom files (effects and firmware): never commit
backup/
*.ZDL
*.ZDT
*.DAT
*.bin

# Session logs (they include the pedal's Bluetooth address)
logs/

# Build output
build/
.DS_Store

# Files staged for installation (they contain Zoom effects)
staging/

# Python bytecode and SwiftPM build output
__pycache__/
.build/
.swiftpm/

# Release artifacts and per-architecture builds
dist/
.build-*/
